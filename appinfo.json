{
  "id": "com.movix.client",
  "version": "1.0.3",
  "vendor": "Movix Community",
  "type": "web",
  "main": "index.html",
  "title": "Movix TV",
  "icon": "icon.png",
  "largeIcon": "largeIcon.png",
  "resolution": "1920x1080",
  "requiredPermissions": [
    "network"
  ],
  "supportGpuProcess": true,
  "useAudioOutput": true,
  "handlesRelaunch": true,
  "checkScreenSaver": true,
  "trustLevel": "netcast",
  "privilegedJail": true,
  "disableBackHistoryAPI": true,
  "vendorExtension": {
    "allowCrossDomain": true
  },
  "appDescription": "Client de streaming Movix pour téléviseurs LG webOS avec résolution dynamique d'instance, bloqueur de pubs et support Magic Remote.",
  "category": "entertainment",
  "bgColor": "#050608"
}
